@* @using DataAccess.Models *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BakeryShop</title>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #d4a574;
            --secondary-color: #8b4513;
            --accent-color: #ff6b6b;
            --text-dark: #2c1810;
            --text-light: #6b4c3b;
            --background-light: #fefcf8;
            --background-cream: #f9f5f0;
            --shadow-light: rgba(212, 165, 116, 0.1);
            --shadow-medium: rgba(212, 165, 116, 0.2);
            --gradient-warm: linear-gradient(135deg, #d4a574 0%, #c89660 100%);
            --gradient-soft: linear-gradient(135deg, #fefcf8 0%, #f9f5f0 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--background-light);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* HEADER (Navbar) */
        .navbar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-bottom: 1px solid rgba(212, 165, 116, 0.1);
            padding: 1.25rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 20px rgba(212, 165, 116, 0.08);
        }

        .navbar.scrolled {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            box-shadow: 0 12px 40px rgba(212, 165, 116, 0.15);
            padding: 1rem 0;
        }

        .navbar .container {
            position: relative;
            display: grid;
            grid-template-columns: 250px 1fr 280px;
            gap: 2rem;
            align-items: center;
        }

        /* Brand Section */
        .navbar-brand {
            display: flex;
            align-items: center;
            font-family: 'Dancing Script', cursive;
            font-size: 2rem;
            font-weight: 600;
            color: var(--primary-color);
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
        }

        .navbar-brand:hover {
            transform: scale(1.05) translateY(-2px);
            color: var(--secondary-color);
            text-shadow: 0 4px 15px rgba(212, 165, 116, 0.3);
        }

        .navbar-brand img {
            height: 50px;
            margin-right: 12px;
            filter: drop-shadow(0 4px 12px var(--shadow-light));
            transition: all 0.4s ease;
        }

        .navbar-brand:hover img {
            transform: rotate(-5deg);
            filter: drop-shadow(0 6px 20px var(--shadow-medium));
        }

        /* Navigation Section */
        .navbar-nav-left {
            display: flex !important;
            align-items: center;
            justify-content: flex-start;
            gap: 0.5rem;
        }

        .navbar-nav .nav-link {
            font-weight: 500;
            color: var(--text-light);
            padding: 0.875rem 1.5rem !important;
            border-radius: 30px;
            position: relative;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            text-transform: uppercase;
            font-size: 0.875rem;
            letter-spacing: 0.75px;
            white-space: nowrap;
            overflow: hidden;
        }

        .navbar-nav .nav-link::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--gradient-warm);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 30px;
            transform: scale(0.8);
        }

        .navbar-nav .nav-link:hover::before,
        .navbar-nav .nav-link.active::before {
            opacity: 1;
            transform: scale(1);
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link.active {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(212, 165, 116, 0.25);
        }

        .navbar-nav .nav-link i,
        .navbar-nav .nav-link span {
            position: relative;
            z-index: 2;
        }

        /* Search Section */
        .navbar-search {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .search-container {
            width: 100%;
            max-width: 400px;
            position: relative;
        }

        .search-input-wrapper {
            position: relative;
            display: flex;
            background: var(--background-cream);
            border-radius: 35px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 6px 20px rgba(212, 165, 116, 0.1);
        }

        .search-input-wrapper:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(212, 165, 116, 0.15);
        }

        .search-input-wrapper:focus-within {
            background: white;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(212, 165, 116, 0.2);
        }

        .search-input {
            border: none;
            background: transparent;
            padding: 1rem 1.5rem;
            font-weight: 400;
            font-size: 0.95rem;
            color: var(--text-dark);
            flex: 1;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            box-shadow: none;
        }

        .search-input::placeholder {
            color: var(--text-light);
            opacity: 0.8;
        }

        .search-btn {
            border: none;
            background: var(--gradient-warm);
            color: white;
            padding: 1rem 1.5rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .search-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(45deg, rgba(255,255,255,0.2), transparent);
            transform: translateX(-100%);
            transition: transform 0.6s ease;
        }

        .search-btn:hover::before {
            transform: translateX(100%);
        }

        .search-btn:hover {
            background: var(--secondary-color);
            transform: scale(1.05);
        }

        /* User Actions Section */
        .navbar-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
        }

        .action-item {
            position: relative;
        }

        .icon-link {
            position: relative;
            padding: 0.875rem;
            border-radius: 50%;
            background: var(--background-cream);
            color: var(--text-light);
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 6px 20px rgba(212, 165, 116, 0.1);
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .icon-link:hover {
            background: var(--gradient-warm);
            color: white;
            transform: translateY(-4px) scale(1.1);
            box-shadow: 0 15px 35px rgba(212, 165, 116, 0.25);
        }

        /* Badge Styles */
        .cart-badge,
        .notification-badge,
        .message-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--accent-color);
            color: white;
            border-radius: 50%;
            min-width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 600;
            animation: badge-pulse 2s infinite;
            border: 2px solid white;
            box-shadow: 0 2px 8px rgba(255, 107, 107, 0.3);
        }

        .notification-badge {
            background: #ff4757;
        }

        .message-badge {
            background: #3742fa;
        }

        @@keyframes badge-pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        /* Enhanced Dropdown Styles */
        .dropdown-menu {
            border: none;
            border-radius: 25px;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
            padding: 1.25rem 0;
            margin-top: 0.75rem;
            min-width: 220px;
            transform: translateY(10px) scale(0.95);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(212, 165, 116, 0.1);
        }

        .dropdown-menu.show {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .user-dropdown {
            min-width: 260px;
        }

        .dropdown-header {
            padding: 0.75rem 1.5rem 0.5rem;
            font-weight: 600;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            font-size: 0.95rem;
        }

        .dropdown-header i {
            color: var(--primary-color);
            font-size: 1.1rem;
        }

        .dropdown-item {
            padding: 0.875rem 1.5rem;
            color: var(--text-light);
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 0;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            position: relative;
            overflow: hidden;
        }

        .dropdown-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: var(--gradient-warm);
            transform: scaleY(0);
            transition: all 0.3s ease;
        }

        .dropdown-item:hover::before {
            transform: scaleY(1);
        }

        .dropdown-item:hover {
            background: linear-gradient(135deg, rgba(212, 165, 116, 0.05), rgba(212, 165, 116, 0.1));
            color: var(--secondary-color);
            transform: translateX(8px);
        }

        .dropdown-item.logout-item:hover {
            background: rgba(255, 107, 107, 0.1);
            color: var(--accent-color);
        }

        .dropdown-item i {
            width: 18px;
            text-align: center;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .dropdown-item:hover i {
            opacity: 1;
            transform: scale(1.1);
        }

        .dropdown-divider {
            margin: 0.5rem 1rem;
            border-color: rgba(212, 165, 116, 0.2);
        }

        /* Responsive Design for Desktop */
        @@media (min-width: 1024px) and (max-width: 1199px) {
            .navbar .container {
                grid-template-columns: 220px 1fr 260px;
                gap: 1.5rem;
            }
            
            .search-container {
                max-width: 350px;
            }
        }

        @@media (min-width: 1200px) and (max-width: 1399px) {
            .navbar .container {
                grid-template-columns: 240px 1fr 270px;
                gap: 1.75rem;
            }
        }

        @@media (min-width: 1400px) {
            .navbar .container {
                grid-template-columns: 280px 1fr 320px;
                gap: 2.5rem;
            }
            
            .search-container {
                max-width: 450px;
            }
            
            .navbar-brand {
                font-size: 2.2rem;
            }
            
            .navbar-brand img {
                height: 55px;
            }
        }

        /* Mobile Responsive Overrides */
        @@media (max-width: 991px) {
            .navbar .container {
                display: block;
            }
            
            .navbar-nav-left {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(20px);
                border-radius: 20px;
                padding: 1rem;
                margin-top: 1rem;
                box-shadow: 0 10px 30px var(--shadow-light);
                flex-direction: column;
                gap: 0.5rem;
            }

            .navbar-search {
                margin: 1rem 0;
            }
            
            .search-container {
                max-width: 100%;
            }

            .navbar-actions {
                justify-content: center;
                margin-top: 1rem;
            }
        }

        /* MAIN CONTENT */
        main {
            min-height: calc(100vh - 200px);
            padding-top: 2rem;
            padding-bottom: 3rem;
        }

        /* FOOTER */
        footer.custom-footer {
            background: linear-gradient(135deg, #2c1810 0%, #3d2317 100%);
            color: #f9f5f0;
            padding: 3rem 0 1.5rem;
            margin-top: 4rem;
            position: relative;
            overflow: hidden;
        }

        footer.custom-footer::before {
            content: '';
            position: absolute;
            top: -50px;
            left: -50%;
            width: 200%;
            height: 100px;
            background: var(--gradient-warm);
            transform: rotate(-2deg);
            opacity: 0.1;
        }

        .footer-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            position: relative;
            z-index: 2;
        }

        .footer-section h5 {
            font-family: 'Dancing Script', cursive;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 1rem;
            position: relative;
        }

        .footer-section h5::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 50px;
            height: 2px;
            background: var(--accent-color);
        }

        .footer-section p,
        .footer-section a {
            margin: 0.5rem 0;
            color: #d4c4b8;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

        .footer-section a:hover {
            color: var(--primary-color);
            transform: translateX(5px);
        }

        .footer-section i {
            margin-right: 0.75rem;
            width: 20px;
            color: var(--primary-color);
        }

        .footer-logo {
            text-align: center;
            grid-column: 1 / -1;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(212, 165, 116, 0.2);
        }

        .footer-logo img {
            height: 60px;
            filter: drop-shadow(0 4px 15px rgba(212, 165, 116, 0.3));
            transition: transform 0.3s ease;
        }

        .footer-logo img:hover {
            transform: scale(1.1) rotate(5deg);
        }

        .footer-copyright {
            text-align: center;
            margin-top: 1rem;
            font-size: 0.9rem;
            opacity: 0.8;
        }

        /* MOBILE RESPONSIVENESS */
        @@media (max-width: 991px) {
            .navbar .container {
                display: block;
            }
            
            .navbar-nav-left {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(20px);
                border-radius: 20px;
                padding: 1rem;
                margin-top: 1rem;
                box-shadow: 0 10px 30px var(--shadow-light);
                flex-direction: column;
                gap: 0.5rem;
            }

            .navbar-search {
                margin: 1rem 0;
            }
            
            .search-container {
                max-width: 100%;
            }

            .navbar-actions {
                justify-content: center;
                margin-top: 1rem;
            }
        }

        @@media (max-width: 768px) {
            .footer-container {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .footer-section h5::after {
                left: 50%;
                transform: translateX(-50%);
            }
        }

        /* SMOOTH SCROLLING */
        html {
            scroll-behavior: smooth;
        }

        /* LOADING ANIMATION */
        .loading {
            opacity: 0;
            animation: fadeIn 0.8s ease-in-out forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* CUSTOM SCROLLBAR */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--background-cream);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--gradient-warm);
            border-radius: 20px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--secondary-color);
        }
    </style>
</head>

<body class="loading">
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/img/logo/logo.png" alt="BakeryShop Logo" />
                    <span>Bakery Shop</span>
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars" style="color: var(--primary-color); font-size: 1.5rem;"></i>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Navigation Links (Left Section) -->
                    <ul class="navbar-nav navbar-nav-left mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-2"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
                               asp-controller="Product" asp-action="Index" asp-route-categoryId="0">
                                <i class="fas fa-birthday-cake me-2"></i>Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Contact" ? "active" : "")"
                               asp-controller="Contact" asp-action="Index">
                                <i class="fas fa-envelope me-2"></i>Contact
                            </a>
                        </li>
                    </ul>

                    <!-- Search Bar (Center Section) -->
                    <div class="navbar-search flex-grow-1 d-flex justify-content-center">
                        <div class="search-container">
                            <form class="search-form d-flex" method="GET" asp-controller="Product" asp-action="Index">
                                <div class="search-input-wrapper">
                                    <input type="search" name="searchTerm" class="form-control search-input" 
                                           placeholder="Search for delicious treats..." aria-label="Search products"
                                           value="@ViewBag.SearchTerm" />
                                    <button type="submit" class="search-btn" aria-label="Search">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- User Actions (Right Section) -->
                    <div class="navbar-actions">
                        <div class="action-item">
                            <a href="#" class="icon-link notification-link" aria-label="Notifications" title="Notifications">
                                <i class="fas fa-bell"></i>
                                <span class="notification-badge">3</span>
                            </a>
                        </div>

                        <div class="action-item">
                            <a href="#" class="icon-link message-link" aria-label="Messages" title="Messages">
                                <i class="fas fa-envelope"></i>
                                <span class="message-badge">2</span>
                            </a>
                        </div>

                        <div class="action-item">
                            <a href="/Cart" class="icon-link cart-link" aria-label="Shopping Cart" title="Shopping Cart">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-badge">
                                    @(ViewBag.TotalCartCount ?? "0")
                                </span>
                            </a>
                        </div>

                        <div class="action-item user-action">
                            <div class="dropdown">
                                @if (Context.Session.GetInt32("UserToken") != null)
                                {
                                    <a class="icon-link user-link dropdown-toggle" href="#" id="userDropdown" 
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                       aria-label="User menu" title="User menu">
                                        <i class="fas fa-user-circle"></i>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end user-dropdown" aria-labelledby="userDropdown">
                                        <li class="dropdown-header">
                                            <i class="fas fa-user-circle me-2"></i>
                                            <span>Hello, User!</span>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-action="Profile" asp-controller="Common">
                                            <i class="fas fa-user-edit me-3"></i>My Profile
                                        </a></li>
                                        <li><a class="dropdown-item" asp-action="Index" asp-controller="Order">
                                            <i class="fas fa-history me-3"></i>Order History
                                        </a></li>
                                        <li><a class="dropdown-item" href="#">
                                            <i class="fas fa-heart me-3"></i>Favorites
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item logout-item" asp-action="Logout" asp-controller="Common">
                                            <i class="fas fa-sign-out-alt me-3"></i>Sign Out
                                        </a></li>
                                    </ul>
                                }
                                else
                                {
                                    <a class="icon-link login-link" asp-action="Login" asp-controller="Common" 
                                       aria-label="Sign in" title="Sign in">
                                        <i class="fas fa-sign-in-alt"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@
        @RenderBody()
    </main>

    <footer class="custom-footer">
        <div class="container">
            <div class="footer-container">
                <div class="footer-section">
                    <h5>Contact Us</h5>
                    <p><i class="fas fa-envelope"></i>cakywordvietnam@gmail.com</p>
                    <p><i class="fas fa-phone"></i>093 974 0742 (08h00 – 17h00)</p>
                    <p><i class="fas fa-mobile-alt"></i>091 575 1200 (07h00 – 22h00)</p>
                </div>
                <div class="footer-section">
                    <h5>Visit Our Store</h5>
                    <p><i class="fas fa-map-marker-alt"></i>600, đường Nguyễn Văn Cừ (nối dài)</p>
                    <p><i class="fas fa-building"></i>Phường An Bình, quận Ninh Kiều</p>
                    <p><i class="fas fa-city"></i>TP. Cần Thơ, Vietnam</p>
                </div>
                <div class="footer-section">
                    <h5>Follow Us</h5>
                    <a href="#"><i class="fab fa-facebook"></i>Facebook</a>
